# 素材制作平台 Docker Compose 配置示例。
# 复制为 .env 后按需修改；没有 .env 时，docker compose 会使用下面注释中的默认值。
# 不要提交真实凭据：.env 已被 .gitignore 忽略。

# ---- MySQL ----
# 数据库名。如果修改，需同步修改 SPRING_DATASOURCE_URL 中的库名。
MYSQL_DATABASE=xy_material
# 应用连接数据库使用的账号。
MYSQL_USER=xy
# 应用账号密码（示例值，仅用于本地演示）。
MYSQL_PASSWORD=change-me
# MySQL root 密码（示例值，仅用于本地演示）。
MYSQL_ROOT_PASSWORD=change-me-root

# ---- 后端 ----
# 容器内后端连接 MySQL 的 JDBC URL。默认使用 Compose 服务名 mysql。
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/xy_material?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=xy
SPRING_DATASOURCE_PASSWORD=change-me
# 上传素材和结果文件在容器内的存储目录，对应 uploads 数据卷。
# 必须是容器内的绝对路径；Compose 会把该路径一并作为 uploads 卷的挂载点。
APP_STORAGE_DIR=/data/uploads
# 允许跨域的前端来源；本地 Compose 默认为 http://localhost:3000。
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
# 模拟失败阶段：NONE / CHECKING / GENERATING / FINALIZING。
APP_SIMULATION_FAIL_STAGE=NONE
# 每个阶段的模拟耗时（毫秒），0–60000。
APP_SIMULATION_STAGE_DELAY_MS=3000
# Compose 默认开启模拟控制接口；命令行临时关闭：
# APP_SIMULATION_DEV_API_ENABLED=false docker compose up --build
APP_SIMULATION_DEV_API_ENABLED=true

# ---- 前端 ----
# 浏览器访问后端的地址，构建时内联进前端产物；修改后必须重新 build。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
